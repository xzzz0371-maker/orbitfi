# ============================================================
#  ZZZ Lend 主网部署环境模板（Base · chainId 8453）
#
#  用法：复制为 .env.mainnet 并填写 PRIVATE_KEY / MAINNET_ADMIN 后运行：
#    forge script script/DeployMainnet.s.sol:DeployMainnet \
#      --rpc-url $MAINNET_RPC_URL --broadcast --verify -vvvv
#
#  ⚠️ 严禁把真实私钥提交仓库；.env.mainnet 已被 .gitignore 覆盖（.env.*）。
#  ⚠️ 部署前先用 Safe{Wallet} 界面创建 2/3 多签，把地址填到 MAINNET_ADMIN。
# ============================================================

# --- RPC（Base 主网）---
MAINNET_RPC_URL=https://mainnet.base.org

# --- 部署者（新生成的主网钱包，仅用于部署；收口后撤销角色即可弃用）---
# 生成: cast wallet new
# 给该地址转入足够 Base ETH（预估 gas ~0.05–0.2 ETH，视 verify/是否 timelock）
PRIVATE_KEY=

# --- 多签 Safe（硬前提：先用 Safe{Wallet} 界面创建 2/3 Safe）---
MAINNET_ADMIN=0x0000000000000000000000000000000000000000
# treasury 默认=admin；如需独立 treasury 多签可改
MAINNET_TREASURY=0x0000000000000000000000000000000000000000
# PAUSER 默认=admin；如需独立熔断多签再取消注释
# MAINNET_PAUSER=0x0000000000000000000000000000000000000000

# --- 治理 Timelock（48h，建议；>0 部署 OZ TimelockController，参数变更需延迟执行）---
MAINNET_TIMELOCK_MIN_DELAY=172800

# --- Oracle 风险参数（部署时显式写入；合约默认值不安全，勿依赖默认）---
# 陈价容忍窗口。必须 >= 最长 feed heartbeat（Base 稳定币 feed heartbeat = 86400s，
# 实测更新间隔 11–13h）。低于 86400 会让协议在低波动时段大面积不可用（借款/取抵押/清算全 revert）。
MAINNET_FEED_MAX_STALENESS=93600
# 偏差告警阈值。合约默认 3e17(30%) 等于没有保护。
MAINNET_MAX_DEVIATION=200000000000000000

# --- 利率模型治理通道（不设 = admin 多签，即 2026-09-04 干跑已验行为）---
# 留空/不设置：市场参数快速通道 = admin 多签。危机时多签可立即 applyPreset 切换利率；
#             代价是利率预设变更绕过 Timelock 延时执行。
# 设为 0x0   ：利率变更必须经 Timelock 延时执行，但失去危机快速响应能力。
#             注意：设成 0x0 是显式关闭；这一行默认不启用，需要时取消注释并填 0x0。
# MAINNET_IRM_GOVERNOR=0x0000000000000000000000000000000000000000

# --- 部署记录输出路径 ---
# 真实部署保持默认；干跑（anvil fork / 无 --broadcast）务必指向临时路径，
# 否则会产生一份装满 fork 地址、看起来像真实部署记录的 mainnet.json。
MAINNET_DEPLOYMENTS_OUT=./deployments/mainnet.json

# --- 资产白名单（Base V1：USDC 市场 & ETH 抵押恒启用；wstETH 恒 false）---
ENABLE_USDT=true
ENABLE_DAI=true
ENABLE_WSTETH=false
ENABLE_CBBTC=true

# --- 上限风控（$5万/资产 建议；0 = 不限制；单位 = token wei / raw wei）---
# 换算口径：cap_wei = floor(USD 额度 / 价格) × 10^decimals；以下按 ETH≈$2506 / cbBTC≈$80727 估算，
#           部署前按实时价复核（行情变化时重算，尤其 ETH/cbBTC）。
MAINNET_USDC_SUPPLY_CAP=50000000000                 # 50,000 USDC（6dp）
MAINNET_USDT_SUPPLY_CAP=50000000000                 # 50,000 USDT（6dp）
MAINNET_DAI_SUPPLY_CAP=50000000000000000000000      # 50,000 DAI（18dp）
MAINNET_ETH_COLLATERAL_CAP=19952114924181962752     # ~19.95 ETH（18dp）
MAINNET_CBBTC_COLLATERAL_CAP=61937146               # ~0.619 cbBTC（8dp）

# --- 可选覆盖（默认 = Base 官方地址，已链上核验，一般无需改）---
# MAINNET_ETH_USD_FEED=0x50015f8b17fb2C290Dde41fDc246ed0dcEE93a8b
# MAINNET_USDC_TOKEN=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# MAINNET_USDC_USD_FEED=0x7e860098F58bBFC8648a4311b374B1D669a2bc6B
# MAINNET_USDT_TOKEN=0xfde4C96c8593536E31F229EA8f37b2ADa2699bb2
# MAINNET_USDT_USD_FEED=0xf19d560eB8d2ADf07BD6D13ed03e1D11215721F9
# MAINNET_DAI_TOKEN=0x50c5725949A6F0c72E6C4a641F24049A917DB0Cb
# MAINNET_DAI_USD_FEED=0x591e79239a7d679378eC8c847e5038150364C78F
# MAINNET_CBBTC_TOKEN=0xcbB7C0000aB88B473b1f5aFd9ef808440eed33Bf
# MAINNET_CBBTC_USD_FEED=0x07DA0E54543a844a80ABE69c8A12F22B3aA59f9D

# Basescan/Etherscan API key —— forge verify-contract 合约源码验证用
# 在 https://basescan.org/myapikey 创建；泄露不丢钱，只会耗查询额度
BASESCAN_API_KEY=
