# RPC（必填；Base 主网 RPC）
RPC_URL=https://mainnet.base.org

# 部署记录 JSON 路径（合约+前端均有副本，任选其一；主网部署后 base.json 填真实合约地址）
# 不填时使用包内默认路径（基于包位置解析，与当前工作目录无关）：
#   <repo>/frontend/src/lib/deployments/base.json
# 若显式设置，相对路径按「当前工作目录」解析。
# DEPLOYMENTS=../../frontend/src/lib/deployments/base.json

# 轮询间隔（秒）
POLL_SECONDS=60

# 输出的 base 目录
OUT_DIR=./out

# HF 阈值（1e18 为 1.0；供告警）
WARN_HF=1.1e18
CRIT_HF=1e18

# 未恢复告警的重推间隔（分钟）。0 = 退回"只推一次"的旧行为。
# 默认 15：原实现边沿触发只推一次，运维漏看那一条 CRITICAL 后就再无提示。
ALERT_RENOTIFY_MINUTES=15

# positions.json 的 users 为空时是否允许继续空跑（默认不允许，会以退出码 1 结束）。
# 协议没有事件流，监控完全依赖该名单；空跑输出全绿会造成虚假安全感。
# 仅在"只想验证 RPC 连通性"时设 1。
# ALLOW_EMPTY_WATCHLIST=1

# 可选：告警 webhook（Telegram bot sendMessage 或任意 JSON POST；空则仅写 out/alerts.log）
# ALERT_WEBHOOK_URL=https://api.telegram.org/bot<TOKEN>/sendMessage

# 可选：Telegram bot 告警（WARN/CRITICAL 才推送）。创建 bot: @BotFather -> /newbot 拿 token；
# chat id 获取：先给 bot 发条消息，再 GET https://api.telegram.org/bot<TOKEN>/getUpdates 取 chat.id
# TELEGRAM_BOT_TOKEN=123456:ABC-...
# TELEGRAM_CHAT_ID=123456789

# ============================================================
#  Keeper（npm run keeper / npm run keeper:loop）
#  作用：周期性调用 ChainlinkOracle.updatePrice(asset)，刷新偏差基准 lastValidPrice。
#        该值仅由 updatePrice() 且判定非异常时写入；不刷新则 maxDeviation 保护会逐渐钝化。
#        部署脚本只做一次初始化，持续保鲜靠这里。
#  ⚠️ 权限：updatePrice 是 permissionless 的 —— 此密钥只需 Base gas，**不需要任何协议角色**。
#         请用专用一次性热钱包，绝不要复用 PARAM_ADMIN / PAUSER 的密钥。
# ============================================================
# KEEPER_PRIVATE_KEY=0x...
# 建议显著小于 oracle.maxStaleness（默认 26h）；1h 在 Base 上成本可忽略
# KEEPER_INTERVAL_SECONDS=3600
# 资产清单（取 markets + collaterals，自动去重）
# ASSETS_JSON=config/positions.json
